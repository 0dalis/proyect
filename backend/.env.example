APP_NAME=AsistControl
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010
FRONTEND_URL=http://localhost:4200
SANCTUM_STATEFUL_DOMAINS=localhost:4200,127.0.0.1:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=asist_central
DB_USERNAME=root
DB_PASSWORD=
TENANT_DB_PREFIX=asist_

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@asistcontrol.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe: claves de https://dashboard.stripe.com/apikeys (pk_... / sk_...)
# y el secreto del webhook (whsec_...) que apunta a {APP_URL}/stripe/webhook
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=mxn
CASHIER_CURRENCY_LOCALE=es_MX

# Telescope (/telescope, solo Super Admin). En producción, déjalo en false salvo para diagnosticar.
TELESCOPE_ENABLED=true

# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin). Pega aquí la
# clave del sitio y la secreta. Vacías = sin captcha (solo para desarrollo).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Correo de soporte (avisos de baja y enlace de exportación de datos)
SUPPORT_EMAIL=soporte@asistcontrol.mx
